<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<div class="row g-3 mb-4">
<div class="col-12 col-sm-6 col-xl-3"><a class="text-decoration-none" href="${pageContext.request.contextPath}/admin-products?mode=all"><div class="lux-card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div><div class="page-kicker">Total Products</div><h2 class="fw-bold mt-2 mb-1">${dashboardStats.totalProducts}</h2><small class="text-muted">${dashboardStats.activeProducts} active products</small></div><div class="metric-icon bg-success-subtle text-success"><i class="bi bi-box-seam"></i></div></div></div></a></div>
<div class="col-12 col-sm-6 col-xl-3"><a class="text-decoration-none" href="${pageContext.request.contextPath}/admin-orders?mode=all"><div class="lux-card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div><div class="page-kicker">Total Orders</div><h2 class="fw-bold mt-2 mb-1">${dashboardStats.totalOrders}</h2><small class="text-muted">${dashboardStats.pendingOrders} need attention</small></div><div class="metric-icon bg-primary-subtle text-primary"><i class="bi bi-bag-check"></i></div></div></div></a></div>
<div class="col-12 col-sm-6 col-xl-3"><a class="text-decoration-none" href="${pageContext.request.contextPath}/admin-users?mode=all"><div class="lux-card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div><div class="page-kicker">Customers</div><h2 class="fw-bold mt-2 mb-1">${dashboardStats.totalCustomers}</h2><small class="text-muted">Registered customer accounts</small></div><div class="metric-icon bg-info-subtle text-info"><i class="bi bi-people"></i></div></div></div></a></div>
<div class="col-12 col-sm-6 col-xl-3"><a class="text-decoration-none" href="${pageContext.request.contextPath}/admin-products?mode=all"><div class="lux-card metric-card p-4 h-100"><div class="d-flex justify-content-between"><div><div class="page-kicker">Low Stock</div><h2 class="fw-bold mt-2 mb-1">${dashboardStats.lowStockCount}</h2><small class="text-muted">5 or fewer items remaining</small></div><div class="metric-icon bg-warning-subtle text-warning"><i class="bi bi-exclamation-triangle"></i></div></div></div></a></div>
</div><style>.metric-icon{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.25rem}</style>
