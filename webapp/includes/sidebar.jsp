<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<% String cp = (String) request.getAttribute("currentPage"); if (cp == null) cp = ""; %>
<aside id="sidebar" class="d-flex flex-column flex-shrink-0 p-4">
<a href="${pageContext.request.contextPath}/admin-dashboard" class="d-flex align-items-center mb-4 text-decoration-none px-2"><div class="luxury-icon-box me-3"><i class="bi bi-flower1"></i></div><div><span class="fs-5 fw-bold text-white d-block">FRESH</span><span class="text-uppercase fw-semibold" style="font-size:.65rem;color:var(--lux-gold);letter-spacing:2.5px">M A R K E T</span></div></a>
<div class="text-uppercase px-3 mb-2 fw-semibold" style="font-size:.65rem;color:rgba(255,255,255,.35);letter-spacing:1.5px">Navigation</div>
<ul class="nav nav-pills flex-column mb-auto gap-1">
<li><a href="${pageContext.request.contextPath}/admin-dashboard" class="nav-link lux-nav-link <%= "dashboard".equals(cp) ? "active" : "" %>"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-users?mode=all" class="nav-link lux-nav-link <%= "customers".equals(cp) ? "active" : "" %>"><i class="bi bi-people"></i><span>Customers</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-orders?mode=all" class="nav-link lux-nav-link <%= "orders".equals(cp) ? "active" : "" %>"><i class="bi bi-bag"></i><span>Orders</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-products?mode=all" class="nav-link lux-nav-link <%= "products".equals(cp) ? "active" : "" %>"><i class="bi bi-box-seam"></i><span>Produce & Inventory</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-wholesale" class="nav-link lux-nav-link <%= "wholesale".equals(cp) ? "active" : "" %>"><i class="bi bi-boxes"></i><span>Wholesale</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-wholesale-pricing" class="nav-link lux-nav-link <%= "wholesale-pricing".equals(cp) ? "active" : "" %>"><i class="bi bi-tags"></i><span>Wholesale Pricing</span></a></li>
<li><a href="${pageContext.request.contextPath}/admin-payments" class="nav-link lux-nav-link <%= "transactions".equals(cp) ? "active" : "" %>"><i class="bi bi-credit-card-2-front"></i><span>Transactions</span></a></li>
</ul>
<div class="pt-3 border-top border-secondary border-opacity-10"><div class="d-flex align-items-center text-white p-2 rounded-3"><div class="rounded-circle bg-success me-3 d-flex align-items-center justify-content-center" style="width:38px;height:38px"><i class="bi bi-person-fill"></i></div><div class="text-truncate"><div class="fw-semibold small text-truncate"><%= session.getAttribute("loginUser") != null ? ((entity.User)session.getAttribute("loginUser")).getName() : "Administrator" %></div><div style="font-size:.72rem;color:rgba(255,255,255,.45)">Administrator</div></div></div><a class="btn btn-sm w-100 mt-2 text-start text-white-50" href="${pageContext.request.contextPath}/admin-users?mode=logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></div>
</aside><div class="admin-overlay" id="adminOverlay"></div>
<style>.luxury-icon-box{width:36px;height:36px;background:linear-gradient(135deg,#1B4332,#2D6A4F);color:#D4AF37;border-radius:10px;display:flex;align-items:center;justify-content:center}.lux-nav-link{color:rgba(255,255,255,.62)!important;padding:.75rem 1rem;display:flex;align-items:center;gap:.85rem;border-radius:10px;font-weight:500}.lux-nav-link i{font-size:1.1rem;color:rgba(255,255,255,.45)}.lux-nav-link:hover{color:#fff!important;background:rgba(255,255,255,.05)}.lux-nav-link.active{color:#fff!important;background:linear-gradient(90deg,rgba(27,67,50,.8),rgba(27,67,50,.25));border-left:3px solid var(--lux-gold)}.lux-nav-link.active i{color:var(--lux-gold)}</style>
