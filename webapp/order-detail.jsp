<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Order #${order.id} — Fresh Market</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/bootstrap.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>body{background:#f7f8f5;color:#20352d}.card{border:0;border-radius:18px;box-shadow:0 8px 26px rgba(20,40,30,.05)}.section-title{font-weight:750;color:#29483b}.status-pill{border-radius:50rem;padding:.55rem .9rem;font-weight:700}.step{display:flex;gap:.8rem;align-items:flex-start;padding:.65rem 0}.step-icon{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#e9f1eb;color:#2c6547;flex:0 0 34px}.muted{color:#718078}.product-img{width:62px;height:62px;object-fit:cover;border-radius:12px;background:#eef2ee}</style></head><body>
<jsp:include page="components/menuBar.jsp" />
<main class="container py-4 py-lg-5">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><a href="${pageContext.request.contextPath}/orders?mode=list" class="small text-decoration-none text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to My Orders</a><h1 class="h2 fw-bold mt-2 mb-1">Order #<c:out value="${order.id}"/></h1><div class="muted small">Placed on <c:out value="${order.orderDate}"/></div></div>
<div><c:choose><c:when test="${order.status == 'DELIVERED' or order.status == 'delivered'}"><span class="badge text-bg-success status-pill"><i class="bi bi-check-circle me-1"></i>Delivered</span></c:when><c:when test="${order.status == 'SHIPPED' or order.status == 'shipped'}"><span class="badge text-bg-info status-pill"><i class="bi bi-truck me-1"></i>Shipped</span></c:when><c:when test="${order.status == 'CANCELLED' or order.status == 'cancelled'}"><span class="badge text-bg-danger status-pill"><i class="bi bi-x-circle me-1"></i>Cancelled</span></c:when><c:when test="${order.status == 'CONFIRMED' or order.status == 'confirmed'}"><span class="badge text-bg-primary status-pill">Confirmed</span></c:when><c:otherwise><span class="badge text-bg-warning status-pill"><i class="bi bi-clock me-1"></i><c:out value="${order.status}"/></span></c:otherwise></c:choose></div></div>
<div class="row g-4"><section class="col-lg-8"><div class="card overflow-hidden"><div class="p-4 border-bottom"><h2 class="h5 section-title mb-0">Order Items</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Product</th><th class="text-end">Unit Price</th><th class="text-center">Qty</th><th class="text-end pe-4">Subtotal</th></tr></thead><tbody><c:forEach var="item" items="${orderItems}"><tr><td class="ps-4"><div class="d-flex align-items-center gap-3"><c:choose><c:when test="${not empty item.product.imageUrl}"><img class="product-img" src="${pageContext.request.contextPath}/<c:out value='${item.product.imageUrl}'/>" alt="<c:out value='${item.product.name}'/>"/></c:when><c:otherwise><div class="product-img d-grid place-items-center"><i class="bi bi-basket fs-3"></i></div></c:otherwise></c:choose><div><div class="fw-semibold"><c:out value="${item.product.name}"/></div><small class="muted">Product #<c:out value="${item.product.id}"/></small></div></div></td><td class="text-end"><fmt:formatNumber value="${item.price}" pattern="#,##0.00"/> MMK</td><td class="text-center"><c:out value="${item.qty}"/></td><td class="text-end pe-4 fw-bold"><fmt:formatNumber value="${item.price * item.qty}" pattern="#,##0.00"/> MMK</td></tr></c:forEach></tbody></table></div></div>
<div class="card mt-4"><div class="p-4 border-bottom"><h2 class="h5 section-title mb-0"><i class="bi bi-truck me-2"></i>Order Status</h2></div><div class="p-4"><c:choose><c:when test="${order.status == 'cancelled' or order.status == 'CANCELLED'}"><div class="step"><div class="step-icon"><i class="bi bi-x-lg"></i></div><div><div class="fw-bold">Order Cancelled</div><div class="small muted">This order is no longer being processed.</div></div></div></c:when><c:otherwise><div class="step"><div class="step-icon"><i class="bi bi-receipt"></i></div><div><div class="fw-bold">Order Placed</div><div class="small muted">Your order has been received.</div></div></div><div class="step"><div class="step-icon"><i class="bi bi-box-seam"></i></div><div><div class="fw-bold">Processing / Confirmed</div><div class="small muted">Current status: <strong><c:out value="${order.status}"/></strong></div></div></div><div class="step"><div class="step-icon"><i class="bi bi-truck"></i></div><div><div class="fw-bold">Shipped</div><div class="small muted">Your order will appear as shipped when the admin updates its status.</div></div></div><div class="step"><div class="step-icon"><i class="bi bi-house-check"></i></div><div><div class="fw-bold">Delivered</div><div class="small muted">Delivery completion will be reflected here.</div></div></div></c:otherwise></c:choose></div></div></section>
<aside class="col-lg-4"><div class="card mb-4"><div class="p-4 border-bottom"><h2 class="h5 section-title mb-0"><i class="bi bi-geo-alt me-2"></i>Shipping Address</h2></div><div class="p-4"><c:choose><c:when test="${not empty order.shippingCity}"><div class="fw-bold"><c:out value="${order.shippingCity}"/></div><div class="mt-1"><c:out value="${order.shippingTownship}"/> Township</div><div><c:out value="${order.shippingStreet}"/></div><c:if test="${not empty order.shippingDescription}"><hr><div class="small muted fw-semibold mb-1">Delivery instructions</div><div class="small"><c:out value="${order.shippingDescription}"/></div></c:if></c:when><c:otherwise><div class="text-secondary small">No shipping address was saved for this order.</div></c:otherwise></c:choose></div></div>
<div class="card mb-4"><div class="p-4 border-bottom"><h2 class="h5 section-title mb-0">Order Summary</h2></div><div class="p-4"><div class="d-flex justify-content-between mb-2"><span class="muted">Order type</span><strong><c:out value="${order.orderType}"/></strong></div><div class="d-flex justify-content-between mb-2"><span class="muted">Order status</span><strong><c:out value="${order.status}"/></strong></div><div class="d-flex justify-content-between mb-2"><span class="muted">Shipping</span><strong class="text-success">Free</strong></div><hr><div class="d-flex justify-content-between align-items-center"><span class="fw-bold">Total</span><span class="h4 text-success fw-bold mb-0"><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0.00"/> MMK</span></div></div></div>
<c:if test="${order.status != 'cancelled' and order.status != 'CANCELLED' and order.status != 'delivered' and order.status != 'DELIVERED'}"><div class="card"><div class="p-4"><h2 class="h5 section-title">Payment</h2><p class="small muted">Continue to the payment page to complete payment for this order.</p><a href="${pageContext.request.contextPath}/payments?mode=pay&amp;orderId=${order.id}" class="btn btn-success rounded-pill w-100 py-2"><i class="bi bi-credit-card me-2"></i>Pay Now</a></div></div></c:if></aside></div></main>
<script src="${pageContext.request.contextPath}/js/bootstrap.bundle.min.js"></script></body></html>
